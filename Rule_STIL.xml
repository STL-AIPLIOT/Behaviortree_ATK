<?xml version="1.0" encoding="UTF-8"?>

<root main_tree_to_execute="MainTree">

    <BehaviorTree ID="MainTree">

        <Sequence name="MainCombatSequence">

            <!-- ========================================= -->
            <!-- 1. 전투 정보 업데이트                     -->
            <!-- ========================================= -->
            <Sequence name="UpdateCombatInformation">

                <SelectTarget BB="{BB}"/>
                <DistanceUpdate BB="{BB}"/>
                <CheckSight BB="{BB}"/>

                <!-- 반드시 먼저 방향 벡터를 갱신 -->
                <DirectionVectorUpdate BB="{BB}"/>

                <!-- 위에서 계산한 방향 벡터에 의존 -->
                <AngleOffUpdate BB="{BB}"/>
                <AspectAngleUpdate BB="{BB}"/>

                <EnergyCompare BB="{BB}"/>
                <PredictManeuver BB="{BB}"/>

            </Sequence>

            <!-- ========================================= -->
            <!-- 2. BFM 모드 선택 및 행동 실행             -->
            <!-- 좁고 긴급한 조건부터 넓은 조건 순서       -->
            <!-- ========================================= -->
            <Fallback name="SelectAndExecuteBFM">

                <!-- 지면 회피: 모든 BFM 보다 우선한다. -->
                <!--                                                                      -->
                <!-- [수정 2026-08-17] Altitude 1200 -> 450.                              -->
                <!--                                                                      -->
                <!-- 1200m 는 규정 §5 의 초기 배치 고도("약 2000~3000ft" = 약 610~914m)보다 -->
                <!-- **높다**. 대회 서버에서는 경기 시작 순간부터 이 분기가 Fallback 최상단을 -->
                <!-- 계속 점유해 SCISSORS/HABFM/OBFM/DBFM 이 한 번도 실행되지 않는다.        -->
                <!-- 교전 자체가 성립하지 않는 값이었다. 주최측 교전뷰어 패치(BattleServer   -->
                <!-- V0.1)로 초기 고도가 시나리오 설정값이 됐으므로 더더욱 고정 가정은 위험하다.-->
                <!--                                                                      -->
                <!-- 450m 는 추락선 300m 위 150m 여유이고 어떤 초기 배치 고도보다 낮다.      -->
                <!-- 급강하 방어는 DECO_AltitudeCheck 의 3초 예측 고도가 맡는다:            -->
                <!--   -244 m/s 강하 -> 1182m 에서 발화(예전 정적 1200m 과 사실상 동일)      -->
                <!--   -60  m/s 강하 ->  630m 에서 발화                                    -->
                <!-- 여기 값과 Task_ClimbToSafeAltitude 의 kFloor 는 항상 같아야 한다.       -->
                <!--                                                                      -->
                <!-- 우선권은 매 tick 이 체크가 재평가해 유지한다. Task 가 RUNNING 을 -->
                <!-- 돌려주는 방식이 아니다 - SyncActionNode 는 RUNNING 에서 예외를 던진다. -->
                <Sequence name="GroundAvoidance_Branch">
                    <DECO_AltitudeCheck BB="{BB}" UpDown="Less" Altitude="1200"/>
                    <Task_ClimbToSafeAltitude BB="{BB}"/>
                </Sequence>

                <!-- SCISSORS: 에너지 열세 및 근접 상황 -->
                <Sequence name="SCISSORS_Branch">
                    <SetBFMMode_SCISSORS BB="{BB}"/>

                    <Fallback name="SCISSORS_Action">
                        <Task_ScissorBreakTurn BB="{BB}"/>
                        <Task_ScissorRollBack BB="{BB}"/>
                        <Task_EvasiveRollOrScissors BB="{BB}"/>
                    </Fallback>
                </Sequence>

                <!-- HABFM: 헤드온 상황 -->
                <Sequence name="HABFM_Branch">
                    <SetBFMMode_HABFM BB="{BB}"/>

                    <Fallback name="HABFM_Action">
                        <!-- 선회 무한 루프 방지: 5초 내 미완료 시 자식을 halt하고 FAILURE 반환 -->
                        <!-- Timeout에는 name 속성을 붙이지 말 것 (xml_parsing.cpp가 부모 name()으로 자식을 연결) -->
                        <!-- 두 Task는 StatefulActionNode다. SyncActionNode면 RUNNING을 반환하지 않아 -->
                        <!-- Timeout이 개입할 틈이 없다 (decorators/timeout_node.cpp:74). -->
                        <!-- 1C/2C 선택은 SetBFMMode_HABFM이 정한 BB->HABFM_CircleMode를 따른다. -->
                        <Timeout msec="5000">
                            <Task_OneCircleAttack BB="{BB}"/>
                        </Timeout>
                        <Timeout msec="5000">
                            <Task_TwoCircleAttack BB="{BB}"/>
                        </Timeout>
                        <!-- 1C/2C가 모두 실패(CircleMode 미정 포함)해도 HABFM이 무행동이 되지 -->
                        <!-- 않도록 하는 reposition. 이게 없으면 HABFM_Branch 전체가 실패해 -->
                        <!-- OBFM으로 새어나간다. -->
                        <Task_MinimizeAngleOff BB="{BB}"/>
                    </Fallback>
                </Sequence>

                <!-- OBFM: 공격 우위 상황 -->
                <Sequence name="OBFM_Branch">
                    <SetBFMMode_OBFM BB="{BB}"/>

                    <Fallback name="OBFM_Action">
                        <!-- 공격형 주 기동. 리드/오버슛(하이 요요)/에너지 보존을 한 노드에서 처리한다. -->
                        <!-- 퇴화 기하(BB nullptr, D~0, 기수 벡터 미갱신)에서만 FAILURE 를 내므로 -->
                        <!-- 아래 세 자식은 통상 경로가 아니라 그 경우를 받는 안전망이다. -->
                        <!-- 교체 전에는 Task_AntiOvershoot 이 이 자리였다(등록은 남아 있다). -->
                        <Task_AggressiveOBFM BB="{BB}"/>
                        <!-- 코너 속도 밴드 + lead 창 + 오버슛 위험 없음, 3조건 동시 충족일 때만 진입 -->
                        <Task_CornerLeadPursuit BB="{BB}"/>
                        <!-- 추종이 3500ms 안에 끝나지 않으면 자식을 halt하고 FAILURE를 반환해 -->
                        <!-- Fallback이 다음 자식(Task_FollowTarget)으로 넘어가게 한다. -->
                        <!-- Timeout에는 name 속성을 붙이지 말 것 (xml_parsing.cpp:599가 부모 name()으로 자식을 연결) -->
                        <Timeout msec="3500">
                            <Task_LeadPursuit BB="{BB}"/>
                        </Timeout>
                        <Task_FollowTarget BB="{BB}"/>
                    </Fallback>
                </Sequence>

                <!-- DBFM: 일반 방어 상황, 가장 넓은 조건 -->
                <Sequence name="DBFM_Branch">
                    <SetBFMMode_DBFM BB="{BB}"/>

                    <Fallback name="DBFM_Action">

                        <!-- 반격 시도가 4000ms 안에 끝나지 않으면 다음 tick에서 1회 재시도 -->
                        <CanRetry max_retries="1" BB="{BB}">
                            <Timeout msec="4000">
                                <DECO_CounterAttackCheck BB="{BB}">
                                    <Task_RollReverseAttack BB="{BB}"/>
                                </DECO_CounterAttackCheck>
                            </Timeout>
                        </CanRetry>

                        <Task_EvasiveRollOrScissors BB="{BB}"/>
                        <Task_CounterTurn BB="{BB}"/>

                    </Fallback>
                </Sequence>

                <!-- AlwaysSuccess 대신 실제 기본 행동 -->
                <!-- Normal tracking: FollowTarget is the primary tracking behavior, Task_Pure is the final fallback. -->
                <Fallback name="NormalTracking">
                    <Task_FollowTarget BB="{BB}"/>
                    <Task_Pure BB="{BB}"/>
                </Fallback>

            </Fallback>

        </Sequence>

    </BehaviorTree>

</root>